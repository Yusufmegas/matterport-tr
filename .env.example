# -------------------------------------------------------------------
# Matterport TR — Teklif Formu SMTP Yapılandırması
# Bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun.
# GERÇEK ŞİFRE VEYA CREDENTIAL'I BU DOSYAYA YAZMAYIN — bu yalnızca örnektir.
# -------------------------------------------------------------------

# SMTP sunucu adresi (sağlayıcınızın verdiği host)
SMTP_HOST=

# SMTP portu (sağlayıcı ayarına göre; yaygın: 587 STARTTLS, 465 SSL)
SMTP_PORT=587

# 465 için true; STARTTLS kullanılan diğer portlar için çoğunlukla false
SMTP_SECURE=false

# SMTP kullanıcı adı
SMTP_USER=

# SMTP şifresi veya uygulama şifresi (ASLA NEXT_PUBLIC_ öneki almaz)
SMTP_PASS=

# E-postada görünen gönderici adı
SMTP_FROM_NAME=Matterport TR

# SMTP sağlayıcısında gönderime yetkili e-posta adresi
SMTP_FROM_EMAIL=

# Teklif bildirimlerinin ulaşacağı şirket e-posta adresi
QUOTE_RECIPIENT_EMAIL=

# Local veya production site adresi (same-origin kontrolünde kullanılır)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
