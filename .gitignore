# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — gerçek env dosyaları asla commit edilmez;
# şablon olan .env.example bilinçli olarak Git'e dahildir
.env
.env.local
.env.*.local
.env.production
.env.development
!.env.example

# netlify (local CLI cache)
.netlify/

# logs
*.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent tooling
.claude/
